<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EFEFEF">

    <!--about menu-->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#002D72"
        app:titleTextColor="@android:color/white"
        android:elevation="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo Section -->
            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Application Logo"
                android:src="@drawable/logo_ia" />

            <!-- Application Title Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Excess Baggage Fee Calculator"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#002D72"
                android:layout_marginBottom="16dp"/>

            <!-- INPUT SECTION (Card Container) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Baggage Weight (kg):"
                    android:textStyle="bold"
                    android:textColor="#002D72"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter weight in kg"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="#4A148C"
                    android:textColorHint="#9E9E9E"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ticket Class:"
                    android:textStyle="bold"
                    android:textColor="#002D72"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <RadioGroup
                    android:id="@+id/rgClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbEconomy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Economy (20kg)"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:checked="true"
                        android:layout_marginRight="16dp"/>

                    <RadioButton
                        android:id="@+id/rbBusiness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Business (40kg)"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excess Rate per kg (RM):"
                    android:textStyle="bold"
                    android:textColor="#002D72"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <EditText
                    android:id="@+id/etRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter rate in RM"
                    android:inputType="numberDecimal"
                    android:textSize="16sp"
                    android:textColor="#4A148C"
                    android:textColorHint="#9E9E9E"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <!-- Calculation Button Section -->
            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Calculate Fee"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- RESULTS SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculation Results:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#002D72"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvExcessWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excess Baggage Weight: 0.00 kg"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvExcessCharge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excess Baggage Charge: RM 0.00"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvTotalPayable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Amount Payable (inc. 8% tax): RM 0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>